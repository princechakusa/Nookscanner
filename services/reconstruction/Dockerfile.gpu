# Nookscanner reconstruction worker image (ADR-004, ADR-018).
# ONE image for both compute targets: Modal (cloud GPU, free credit + spend limit) and the user's
# own NVIDIA PC (docker run --gpus all ... poll). Build context: the repository root.
#   docker build -f services/reconstruction/Dockerfile.gpu -t nookscanner-worker .
# Pinned (released >= 2 weeks before 2026-11-20): CUDA 12.6.3, COLMAP 4.2.1, gsplat 1.5.3,
# PyTorch 2.7.1 (cu126), Node 22 LTS, @playcanvas/splat-transform 3.10.3.
# Licences: COLMAP BSD-3 (third-party deps: KNOWN_ISSUES KI-004), gsplat Apache-2.0,
# SplatTransform MIT. The INRIA reference code is NOT used (non-commercial licence).

FROM nvidia/cuda:12.6.3-devel-ubuntu24.04

ARG COLMAP_VERSION=4.2.1
ARG GSPLAT_VERSION=1.5.3
ARG TORCH_VERSION=2.7.1
ARG NODE_VERSION=22.21.1
ARG SPLAT_TRANSFORM_VERSION=3.10.3
# GPU generations compiled for: Turing (RTX 20xx) .. Ada (RTX 40xx, L40S) and Hopper.
ARG CUDA_ARCHS="75;80;86;89;90"

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0" \
    NOOK_SPLAT_GPU=cpu \
    MAX_JOBS=4
# NOOK_SPLAT_GPU=cpu: SOG compression on CPU (identical files, no WebGPU driver needed in the
# container). MAX_JOBS: limits parallel CUDA compilation (memory) on small build machines.

# --- system packages: ffmpeg, Python 3.12, COLMAP build dependencies --------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      git cmake ninja-build build-essential ca-certificates curl xz-utils \
      ffmpeg python3 python3-pip python3-dev python3-venv \
      libboost-program-options-dev libboost-graph-dev libboost-system-dev \
      libeigen3-dev libflann-dev libfreeimage-dev libmetis-dev libgoogle-glog-dev \
      libgtest-dev libgmock-dev libsqlite3-dev libglew-dev libcgal-dev libceres-dev \
      libcurl4-openssl-dev libssl-dev libopenimageio-dev openimageio-tools \
    && rm -rf /var/lib/apt/lists/*

# --- COLMAP (SfM incl. the global mapper) with CUDA, headless ---------------------------------
RUN git clone --depth 1 --branch ${COLMAP_VERSION} https://github.com/colmap/colmap.git /tmp/colmap \
    && cmake -S /tmp/colmap -B /tmp/colmap/build -GNinja \
         -DCMAKE_BUILD_TYPE=Release -DGUI_ENABLED=OFF -DCUDA_ENABLED=ON \
         -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHS}" \
    && cmake --build /tmp/colmap/build --parallel 4 \
    && cmake --install /tmp/colmap/build \
    && rm -rf /tmp/colmap \
    && colmap -h > /dev/null

# --- PyTorch + gsplat (CUDA kernels compiled at build time) + trainer example -----------------
RUN python3 -m pip install setuptools wheel ninja \
    && python3 -m pip install torch==${TORCH_VERSION} torchvision --index-url https://download.pytorch.org/whl/cu126
RUN git clone --depth 1 --branch v${GSPLAT_VERSION} https://github.com/nerfstudio-project/gsplat.git /opt/gsplat \
    && python3 -m pip install --no-build-isolation /opt/gsplat \
    # The example requirements include CUDA extensions (fused-ssim, fused-bilagrid): build them
    # against the installed torch.
    && python3 -m pip install --no-build-isolation -r /opt/gsplat/examples/requirements.txt \
    && python3 -c "import gsplat; print('gsplat', gsplat.__version__)"

# --- Node + SplatTransform (SOG + streamed LOD packaging) -------------------------------------
RUN curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz \
      | tar -xJ -C /usr/local --strip-components=1 \
    && npm install -g @playcanvas/splat-transform@${SPLAT_TRANSFORM_VERSION} \
    && splat-transform --help > /dev/null

# --- the worker -------------------------------------------------------------------------------
# Keep the repository layout: the tests read the shared contract fixture by relative path.
COPY packages/shared/src/fixtures /src/packages/shared/src/fixtures
COPY services/reconstruction /src/services/reconstruction
RUN python3 -m pip install /src/services/reconstruction \
    && cd /src/services/reconstruction && python3 -m unittest discover -s tests -t . -q

WORKDIR /data
# Default: the pull-mode worker for an own GPU PC. Modal runs functions from modal_app.py instead.
ENTRYPOINT ["python3", "-m", "nookscanner_reconstruction.poll"]
