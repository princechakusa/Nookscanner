# Nookscanner environment variables (TEMPLATE). Copy to `.env.local` in apps/dashboard and apps/guest.
# `.env.local` files are git-ignored. Real secrets live only in Vercel / Supabase / Modal / GitHub
# secret stores, separately per environment. See docs/INFRASTRUCTURE.md section 2.

# ---- Public values (safe for browsers) ----
# Hosted Supabase project "nookscanner" (ref nfcnckwjrwpofkrzribd). The publishable key below is the
# PUBLIC anon-equivalent key: it is designed to be shipped to browsers and is protected by RLS.
# It is NOT a service-role/secret key.
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=https://nfcnckwjrwpofkrzribd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_9PuSyQCUK9EswvfA68NmUw_03Ng-q8L
# Guest app base URL that QR codes point to (https only; QR = <url>/a/<token>). Set it once the
# guest app is deployed. With *_APP_ENV=local it defaults to http://localhost:5173.
# NEXT_PUBLIC_GUEST_URL=https://<guest-host>
# Uploads Worker for raw footage on R2 (Stage 5.7; public URL). Dashboard and capture app.
NEXT_PUBLIC_UPLOADS_URL=https://nookscanner-uploads.chakusaprince.workers.dev
EXPO_PUBLIC_UPLOADS_URL=https://nookscanner-uploads.chakusaprince.workers.dev

VITE_APP_ENV=staging
VITE_SUPABASE_URL=https://nfcnckwjrwpofkrzribd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_9PuSyQCUK9EswvfA68NmUw_03Ng-q8L
VITE_GUEST_API_BASE=https://nfcnckwjrwpofkrzribd.supabase.co/functions/v1

# For a local Supabase stack (`npx supabase start`, needs Docker) use instead:
#   *_APP_ENV=local, *_SUPABASE_URL=http://127.0.0.1:56521 and the anon key printed by `supabase start`.

# ---- Server-only secrets: NEVER commit values, NEVER prefix with NEXT_PUBLIC_ or VITE_ ----
# Set these only in secret managers (Supabase function secrets, Modal secrets, CI secrets).
SUPABASE_SERVICE_ROLE_KEY=
RECONSTRUCTION_HMAC_SECRET=
RECONSTRUCTION_WORKER_URL=
